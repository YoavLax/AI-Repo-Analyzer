# Copy to `.env` and fill in. `.env` is gitignored; never commit it, and never
# paste a token into a chat, an issue, or a CI log.
#
# For public repositories a *classic* token with no scopes selected is enough —
# it only raises the API rate limit from 60 to 5,000 requests/hour and grants
# no additional access. That is the least-privilege choice.
GITHUB_TOKEN=

# Optional overrides for the online-scan fetch budget (see README.md).
# MAX_FETCH_FILES=1200
# MAX_FILE_BYTES=2097152
# MAX_TOTAL_BYTES=20971520
